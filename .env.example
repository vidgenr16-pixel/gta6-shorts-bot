# --- Telegram (required) ---
# Create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (message the bot once and it will tell you)
OWNER_ID=
# Where daily shorts get posted: a channel like @mychannel or -100123..., or leave empty to send to yourself.
# For a channel, add the bot as an admin with "Post messages" permission.
POST_CHAT_ID=
POST_TIME=18:00
TIMEZONE=Asia/Kolkata

# --- Optional: Claude writes the hooks and captions (otherwise templates are used) ---
ANTHROPIC_API_KEY=

# --- Editing ---
# Where clips and finished shorts are kept (outside Google Drive)
DATA_DIR=C:\gta6bot\data
# Folder watched for big recordings; a Google Drive folder lets you upload from your phone
# DROP_DIR=G:\My Drive\gta6-drop
CLIP_SECONDS=30
MAX_SHORTS_PER_VIDEO=3
WHISPER_MODEL=small
CHANNEL_HANDLE=
CAPTION_FONT=Arial Black
FG_ZOOM=1.25
MUSIC_VOLUME=0.12
HASHTAGS=#GTA6 #GTAVI #ViceCity #Leonida #gaming #shorts
